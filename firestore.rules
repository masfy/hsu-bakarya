rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Akun Super Admin Utama berbasis email
    function isSuperAdminEmail() {
      return isSignedIn() && request.auth.token.email == 'alfyarnaim@gmail.com';
    }
    
    function getUserData() { 
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {}; 
    }
    
    function hasRole(roles) { 
      return isSuperAdminEmail() || (isSignedIn() && getUserData().get('accountStatus', '') == 'active' && getUserData().get('role', '') in roles); 
    }
    
    function isAdmin() { 
      return isSuperAdminEmail() || hasRole(['admin', 'superAdmin']); 
    }

    // Koleksi Karya Digital (Works)
    match /works/{workId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if true;
      allow delete: if isSuperAdminEmail() || isAdmin();
    }

    // Koleksi Pengguna (Users)
    match /users/{userId} {
      allow read: if true;
      allow create: if isSuperAdminEmail() || isSignedIn() || (request.resource.data.accountStatus == 'pending');
      allow update: if isSuperAdminEmail() || (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isSuperAdminEmail() || isAdmin();
    }

    // Koleksi Taksonomi (Mata Pelajaran, Kategori, Format Media)
    match /subjects/{id} {
      allow read: if true;
      allow write: if isSuperAdminEmail() || isSignedIn();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isSuperAdminEmail() || isSignedIn();
    }
    match /mediaTypes/{id} {
      allow read: if true;
      allow write: if isSuperAdminEmail() || isAdmin();
    }

    // Koleksi Moderasi & Audit Log
    match /moderationLogs/{logId} {
      allow read, write: if isSuperAdminEmail() || isAdmin();
    }
    match /auditLogs/{logId} {
      allow read, write: if isSuperAdminEmail() || isAdmin();
    }

    // Koleksi Analitik
    match /analyticsDaily/{dayId} {
      allow read, write: if true;
    }
    match /analyticsMonthly/{monthId} {
      allow read, write: if true;
    }
  }
}
