rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().get('accountStatus', '') == 'active' && getUserData().get('role', '') == 'superAdmin';
    }
    
    function getUserData() { 
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {}; 
    }
    
    function hasRole(roles) { 
      return isSignedIn() && getUserData().get('accountStatus', '') == 'active' && (getUserData().get('role', '') in roles); 
    }
    
    function isAdmin() { 
      return hasRole(['admin', 'superAdmin']); 
    }


    // Koleksi Karya Digital (Works)
    match /works/{workId} {
      allow read, write: if true;
    }

    // Koleksi Pengguna (Users)
    // Diizinkan baca & tulis agar perubahan profil dan kecamatan oleh Admin/Super Admin tersimpan permanen
    match /users/{userId} {
      allow read, write: if true;
    }

    // Koleksi Taksonomi (Mata Pelajaran, Kategori, Format Media)
    match /subjects/{id} {
      allow read, write: if true;
    }
    match /categories/{id} {
      allow read, write: if true;
    }
    match /mediaTypes/{id} {
      allow read, write: if true;
    }

    // Koleksi Moderasi & Audit Log
    match /moderationLogs/{logId} {
      allow read, write: if true;
    }
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // Koleksi Analitik
    match /analyticsDaily/{dayId} {
      allow read, write: if true;
    }
    match /analyticsMonthly/{monthId} {
      allow read, write: if true;
    }
  }
}
