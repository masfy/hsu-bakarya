# Firebase Configuration for BAKARYA Portal
# Dapatkan nilai ini dari Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSyExampleKeyHere
VITE_FIREBASE_AUTH_DOMAIN=bakarya-portal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bakarya-portal
VITE_FIREBASE_STORAGE_BUCKET=bakarya-portal.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Email Super Admin (Opsional - untuk mengenali akun pemilik utama secara otomatis)
# VITE_SUPERADMIN_EMAIL=admin@example.com

# Catatan Keamanan:
# File .env.example ini HANYA berupa template contoh.
# Jangan pernah memasukkan API Key atau kata sandi asli di sini.
# Salin file ini menjadi .env.local dan isi konfigurasi asli Anda di sana.

